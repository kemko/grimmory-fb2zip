@@ -0,0 +1,175 @@
+package org.booklore.service.upload;
+
+import org.booklore.exception.APIException;
+import org.booklore.exception.ApiError;
+import org.booklore.service.metadata.extractor.Fb2MetadataExtractor;
+import org.booklore.service.file.FileFingerprint;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import static org.assertj.core.api.Assertions.*;
+
+class Fb2ZipUploadExtractorTest {
+    @TempDir Path tempDir;
+    static final byte[] FB2 = ("<FictionBook xmlns=\"http://www.gribuser.ru/xml/fictionbook/2.0\">"
+            + "<description><title-info><book-title>Книга</book-title></title-info></description>"
+            + "<binary id=\"cover.png\" content-type=\"image/png\">AQIDBA==</binary>"
+            + "<body><section><p>" + "Текст ".repeat(300) + "</p></section></body></FictionBook>").getBytes(StandardCharsets.UTF_8);
+
+    static byte[] zip(Map<String, byte[]> entries) throws IOException {
+        var bytes = new ByteArrayOutputStream();
+        try (var zip = new ZipOutputStream(bytes)) {
+            for (var entry : entries.entrySet()) {
+                zip.putNextEntry(new ZipEntry(entry.getKey()));
+                zip.write(entry.getValue());
+                zip.closeEntry();
+            }
+        }
+        return bytes.toByteArray();
+    }
+
+    static Set<Path> uploadTemps() throws IOException {
+        try (var paths = Files.list(Path.of(System.getProperty("java.io.tmpdir")))) {
+            return paths.filter(path -> path.getFileName().toString().startsWith("upload-")
+                    || path.getFileName().toString().startsWith("bookdrop-")).collect(Collectors.toSet());
+        }
+    }
+
+    private Path archive(byte[] bytes) throws IOException {
+        return Files.write(tempDir.resolve("book.fb2.zip"), bytes);
+    }
+
+    private void rejects(byte[] bytes) throws IOException {
+        Set<Path> before = uploadTemps();
+        assertThatThrownBy(() -> Fb2ZipUploadExtractor.extract(archive(bytes), 1)).isInstanceOf(APIException.class);
+        assertThat(uploadTemps()).isEqualTo(before);
+    }
+
+    @Test
+    void preservesBytesMetadataCoverAndHashForNestedUppercaseFb2() throws Exception {
+        Path plain = Files.write(tempDir.resolve("plain.fb2"), FB2);
+        Path result = Fb2ZipUploadExtractor.extract(archive(zip(Map.of("nested/", new byte[0], "nested/Книга.FB2", FB2))), 1);
+        try {
+            assertThat(Files.readAllBytes(result)).isEqualTo(FB2);
+            var extractor = new Fb2MetadataExtractor();
+            assertThat(extractor.extractMetadata(result.toFile())).usingRecursiveComparison().isEqualTo(extractor.extractMetadata(plain.toFile()));
+            assertThat(extractor.extractMetadata(result.toFile()).getTitle()).isEqualTo("Книга");
+            assertThat(extractor.extractCover(result.toFile())).containsExactly(1, 2, 3, 4);
+            assertThat(FileFingerprint.generateHash(result)).isEqualTo(FileFingerprint.generateHash(plain));
+        } finally {
+            Files.delete(result);
+        }
+    }
+
+    @Test
+    void preservesWindows1251() throws Exception {
+        byte[] data = ("<?xml version=\"1.0\" encoding=\"windows-1251\"?><FictionBook><body>Книга</body></FictionBook>").getBytes(Charset.forName("windows-1251"));
+        Path result = Fb2ZipUploadExtractor.extract(archive(zip(Map.of("book.fb2", data))), 1);
+        try {
+            assertThat(Files.readAllBytes(result)).isEqualTo(data);
+        } finally {
+            Files.delete(result);
+        }
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"../book.fb2", "dir/../book.fb2", "/book.fb2", "C:/book.fb2", "..\\book.fb2", "readme.txt"})
+    void rejectsUnsafeAndForeignEntries(String name) throws Exception {
+        rejects(zip(Map.of(name, FB2)));
+    }
+
+    @Test
+    void rejectsEmptyMultipleAndMixedArchives() throws Exception {
+        rejects(zip(Map.of()));
+        rejects(zip(Map.of("dir/", new byte[0])));
+        rejects(zip(Map.of("one.fb2", FB2, "two.fb2", FB2)));
+        rejects(zip(Map.of("one.fb2", FB2, "readme.txt", new byte[0])));
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"", "not xml", "<FictionBook>", "<html/>", "<!DOCTYPE FictionBook [<!ENTITY xxe SYSTEM 'file:///etc/passwd'>]><FictionBook>&xxe;</FictionBook>"})
+    void rejectsInvalidXmlAndDoctype(String xml) throws Exception {
+        rejects(zip(Map.of("book.fb2", xml.getBytes(StandardCharsets.UTF_8))));
+    }
+
+    @Test
+    void rejectsInvalidTruncatedEncryptedAndBadCrcArchives() throws Exception {
+        rejects(new byte[0]);
+        rejects("not a zip".getBytes(StandardCharsets.UTF_8));
+        byte[] valid = zip(Map.of("book.fb2", FB2));
+        rejects(Arrays.copyOf(valid, valid.length - 22));
+        int central = -1;
+        for (int i = 0; i < valid.length - 4; i++) {
+            if (valid[i] == 0x50 && valid[i + 1] == 0x4b && valid[i + 2] == 1 && valid[i + 3] == 2) {
+                central = i;
+                break;
+            }
+        }
+        assertThat(central).isPositive();
+        byte[] corrupt = valid.clone();
+        corrupt[central + 16] ^= 1;
+        rejects(corrupt);
+        byte[] encrypted = valid.clone();
+        encrypted[central + 8] |= 1;
+        encrypted[6] |= 1;
+        rejects(encrypted);
+    }
+
+    @Test
+    void boundsActualInflatedBytesWithValidFb2() throws Exception {
+        int limit = 1024 * 1024;
+        String opening = "<FictionBook><body><section><p>";
+        String closing = "</p></section></body></FictionBook>";
+        byte[] atLimit = (opening + "a".repeat(limit - opening.length() - closing.length()) + closing)
+                .getBytes(StandardCharsets.UTF_8);
+        Path result = Fb2ZipUploadExtractor.extract(archive(zip(Map.of("book.fb2", atLimit))), 1);
+        try {
+            assertThat(Files.readAllBytes(result)).isEqualTo(atLimit);
+        } finally {
+            Files.delete(result);
+        }
+        byte[] overLimit = (opening + "a".repeat(limit + 1 - opening.length() - closing.length()) + closing)
+                .getBytes(StandardCharsets.UTF_8);
+        Set<Path> before = uploadTemps();
+        Path oversized = archive(zip(Map.of("book.fb2", overLimit)));
+        APIException expected = ApiError.FILE_TOO_LARGE.createException(1);
+        assertThatThrownBy(() -> Fb2ZipUploadExtractor.extract(oversized, 1))
+                .isInstanceOf(APIException.class).hasMessage(expected.getMessage())
+                .extracting(error -> ((APIException) error).getStatus()).isEqualTo(expected.getStatus());
+        assertThat(uploadTemps()).isEqualTo(before);
+    }
+
+    @Test
+    void rejectsDirectoryPayloadAlongsideValidFb2() throws Exception {
+        Set<Path> before = uploadTemps();
+        Path malformed = archive(zip(Map.of("book.fb2", FB2, "directory/", new byte[]{1})));
+        assertThatThrownBy(() -> Fb2ZipUploadExtractor.extract(malformed, 1))
+                .isInstanceOf(APIException.class)
+                .hasMessage(ApiError.INVALID_FILE_FORMAT.createException("ZIP directory contains file data").getMessage());
+        assertThat(uploadTemps()).isEqualTo(before);
+    }
+
+    @Test
+    void rejectsTooManyEntries() throws Exception {
+        Map<String, byte[]> entries = new LinkedHashMap<>();
+        for (int i = 0; i < 1024; i++) entries.put(i + "/", new byte[0]);
+        entries.put("book.fb2", FB2);
+        rejects(zip(entries));
+    }
+}
