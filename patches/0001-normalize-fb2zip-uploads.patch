+package org.booklore.service.upload;
+
+import org.booklore.exception.ApiError;
+import org.booklore.util.SecureXmlUtils;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Locale;
+import java.util.zip.CRC32;
+import java.util.zip.ZipFile;
+import java.util.zip.ZipException;
+
+final class Fb2ZipUploadExtractor {
+    private static final int MAX_ENTRIES = 1024;
+
+    private Fb2ZipUploadExtractor() {}
+
+    static boolean accepts(String name) {
+        return name.toLowerCase(Locale.ROOT).endsWith(".fb2.zip");
+    }
+
+    static String bookName(String name) {
+        return accepts(name) ? name.substring(0, name.length() - 8) + ".fb2" : name;
+    }
+
+    static Path extract(Path archive, int maxSizeMb) throws IOException {
+        Path output = Files.createTempFile("upload-", ".fb2");
+        boolean complete = false;
+        try {
+            try (ZipFile zip = new ZipFile(archive.toFile())) {
+                // ZipFile requires a central directory; ZipInputStream alone accepts truncated archives.
+                var entries = zip.entries();
+                int count = 0;
+                boolean foundBook = false;
+                long bytes = 0;
+                byte[] buffer = new byte[8192];
+                while (entries.hasMoreElements()) {
+                    var entry = entries.nextElement();
+                    String name = entry.getName().replace('\\', '/');
+                    if (++count > MAX_ENTRIES || name.startsWith("/") || name.matches("^[A-Za-z]:.*")
+                            || java.util.Arrays.asList(name.split("/")).contains("..")) {
+                        throw ApiError.INVALID_FILE_FORMAT.createException("Unsafe ZIP entry or too many entries");
+                    }
+                    if (!entry.isDirectory()) {
+                        if (foundBook || !name.toLowerCase(Locale.ROOT).endsWith(".fb2")) {
+                            throw ApiError.INVALID_FILE_FORMAT.createException("Archive must contain exactly one FB2 file");
+                        }
+                        foundBook = true;
+                    }
+                    CRC32 crc = new CRC32();
+                    try (var input = zip.getInputStream(entry);
+                         var target = entry.isDirectory() ? java.io.OutputStream.nullOutputStream() : Files.newOutputStream(output)) {
+                        int read;
+                        while ((read = input.read(buffer)) != -1) {
+                            bytes += read;
+                            if (bytes > maxSizeMb * 1024L * 1024L) {
+                                throw ApiError.FILE_TOO_LARGE.createException(maxSizeMb);
+                            }
+                            if (entry.isDirectory() && read > 0) {
+                                throw ApiError.INVALID_FILE_FORMAT.createException("ZIP directory contains file data");
+                            }
+                            crc.update(buffer, 0, read);
+                            target.write(buffer, 0, read);
+                        }
+                    }
+                    // ZipFile streams do not check CRC automatically. Include directory data in all limits.
+                    if (crc.getValue() != entry.getCrc()) {
+                        throw ApiError.INVALID_FILE_FORMAT.createException("Invalid ZIP CRC");
+                    }
+                }
+                if (!foundBook) {
+                    throw ApiError.INVALID_FILE_FORMAT.createException("Archive must contain exactly one FB2 file");
+                }
+                try {
+                    var document = SecureXmlUtils.createSecureDocumentBuilder(true).parse(output.toFile());
+                    if (document.getDoctype() != null || !"FictionBook".equals(document.getDocumentElement().getLocalName())) {
+                        throw ApiError.INVALID_FILE_FORMAT.createException("Archive does not contain valid FB2 XML");
+                    }
+                } catch (org.xml.sax.SAXException e) {
+                    throw ApiError.INVALID_FILE_FORMAT.createException("Archive does not contain valid FB2 XML");
+                } catch (javax.xml.parsers.ParserConfigurationException e) {
+                    throw new IOException("Cannot configure FB2 XML parser", e);
+                }
+            } catch (ZipException e) {
+                throw ApiError.INVALID_FILE_FORMAT.createException("Invalid FB2 ZIP archive: " + e.getMessage());
+            }
+            complete = true;
+            return output;
+        } finally {
+            if (!complete) {
+                Files.deleteIfExists(output);
+            }
+        }
+    }
+}
