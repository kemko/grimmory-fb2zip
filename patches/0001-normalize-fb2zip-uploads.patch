+    private PreparedUpload prepareUpload(MultipartFile file, String prefix, boolean bookUpload) throws IOException {
+        String name = getValidatedFileName(file);
+        Path source = createTempFile(prefix, name);
+        boolean normalized = bookUpload && Fb2ZipUploadExtractor.accepts(name);
+        try {
+            file.transferTo(source);
+            if (normalized) {
+                int limit = appSettingService.getAppSettings().getMaxFileUploadSizeInMb();
+                if (Files.size(source) > limit * MB_TO_BYTES_MULTIPLIER) {
+                    throw ApiError.FILE_TOO_LARGE.createException(limit);
+                }
+                Path extracted = Fb2ZipUploadExtractor.extract(source, limit);
+                cleanupTempFile(source);
+                source = extracted;
+            }
+            return new PreparedUpload(source, normalized);
+        } catch (IOException | RuntimeException e) {
+            cleanupTempFile(source);
+            throw e;
+        }
+    }
+
+    private final class PreparedUpload implements AutoCloseable {
+        private final Path path;
+        private final boolean normalized;
+        private Path movedPath;
+        private BasicFileAttributes movedAttributes;
+        private boolean complete;
+
+        private PreparedUpload(Path path, boolean normalized) {
+            this.path = path;
+            this.normalized = normalized;
+        }
+
+        private void moveTo(Path target, Path root) throws IOException {
+            if (!normalized) {
+                moveFileToFinalLocation(path, target, root);
+                return;
+            }
+            movedAttributes = Files.readAttributes(path, BasicFileAttributes.class,
+                    LinkOption.NOFOLLOW_LINKS);
+            moveFileToFinalLocation(path, target, root);
+            movedPath = target;
+            movedAttributes = Files.readAttributes(target, BasicFileAttributes.class,
+                    LinkOption.NOFOLLOW_LINKS);
+            if (TransactionSynchronizationManager.isSynchronizationActive()) {
+                TransactionSynchronizationManager.registerSynchronization(new TransactionSynchronization() {
+                    @Override
+                    public void afterCompletion(int status) {
+                        if (status != STATUS_COMMITTED) {
+                            cleanupMovedFile();
+                        }
+                    }
+                });
+            }
+        }
+
+        private void cleanupMovedFile() {
+            if (movedPath != null) {
+                try {
+                    if (Files.exists(movedPath, LinkOption.NOFOLLOW_LINKS) && movedAttributes != null) {
+                        var current = Files.readAttributes(movedPath, BasicFileAttributes.class,
+                                LinkOption.NOFOLLOW_LINKS);
+                        if (Objects.equals(movedAttributes.fileKey(), current.fileKey())
+                                && movedAttributes.creationTime().equals(current.creationTime())
+                                && movedAttributes.lastModifiedTime().equals(current.lastModifiedTime())
+                                && movedAttributes.size() == current.size()) {
+                            Files.delete(movedPath);
+                        }
+                    }
+                    movedPath = null;
+                } catch (IOException e) {
+                    log.warn("Failed to clean up rolled-back FB2 upload: {}", movedPath, e);
+                }
+            }
+        }
+
+        @Override
+        public void close() {
+            cleanupTempFile(path);
+            if (!complete) {
+                cleanupMovedFile();
+            }
         }
     }
 
