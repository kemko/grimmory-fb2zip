+    @Test
+    void fb2ZipSaveFailureAndTransactionRollbackRemoveOnlyNewFile() throws Exception {
+        fb2Book(false);
+        Set<Path> before = uploadTemps();
+        when(bookAdditionalFileRepository.save(any())).thenThrow(new IllegalStateException("database failed"));
+        assertThatThrownBy(() -> service.uploadAdditionalFile(1L, zippedBook("failed.fb2.zip"), true, null, null)).isInstanceOf(IllegalStateException.class);
+        assertThat(tempDir.resolve("failed.fb2")).doesNotExist();
+        doAnswer(call -> call.getArgument(0)).when(bookAdditionalFileRepository).save(any());
+        TransactionSynchronizationManager.initSynchronization();
+        try {
+            service.uploadAdditionalFile(1L, zippedBook("rollback.fb2.zip"), true, null, null);
+            assertThat(tempDir.resolve("rollback.fb2")).exists();
+            for (var callback : TransactionSynchronizationManager.getSynchronizations()) {
+                callback.afterCompletion(TransactionSynchronization.STATUS_ROLLED_BACK);
+            }
+            assertThat(tempDir.resolve("rollback.fb2")).doesNotExist();
+        } finally {
+            TransactionSynchronizationManager.clearSynchronization();
+        }
+        assertThat(uploadTemps()).isEqualTo(before);
+    }
