+import {Directive, inject} from '@angular/core';
+import {FileUpload} from '@openng/optimus-ui/fileupload';
+
+@Directive({
+  selector: 'p-fileupload[appFb2ZipUpload]',
+  standalone: true
+})
+export class Fb2ZipUploadDirective {
+  constructor() {
+    const upload = inject(FileUpload, {self: true});
+    const validate = upload.validate.bind(upload);
+    upload.validate = (file: File) => {
+      const name = file.name.toLowerCase();
+      // Native file pickers need .zip; book uploads still require the full .fb2.zip suffix.
+      if (upload.accept?.split(',').includes('.zip') && name.endsWith('.zip') && !name.endsWith('.fb2.zip')) {
+        const summary = upload.invalidFileTypeMessageSummary.replace('{0}', file.name);
+        const detail = upload.invalidFileTypeMessageDetail.replace('{0}', upload.accept.replace('.zip', '.fb2.zip'));
+        upload.msgs ??= [];
+        upload.msgs.push({severity: 'error', text: `${summary} ${detail}`});
+        return false;
+      }
+      return validate(file);
+    };
+  }
+}
